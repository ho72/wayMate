{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://waymate.local/contracts/vehicle-v1.schema.json",
  "title": "Authenticated personal vehicle state v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "const": "account-trip-v1"
    },
    "status": {
      "enum": [
        "pending",
        "requested",
        "active",
        "revoked"
      ]
    },
    "device": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "canInteract": {
      "type": "boolean"
    },
    "pairing": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "expiresAt": {
              "type": [
                "integer",
                "null"
              ]
            },
            "code": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{8}$"
                }
              ]
            },
            "account": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "displayName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 30
                    },
                    "avatar": {
                      "enum": [
                        "dragon",
                        "bear",
                        "mocha"
                      ]
                    }
                  },
                  "required": [
                    "displayName",
                    "avatar"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "id",
            "expiresAt",
            "code",
            "account"
          ],
          "additionalProperties": false
        }
      ]
    },
    "delivery": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "pairingId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "createdAt": {
              "type": "integer"
            },
            "acknowledgedAt": {
              "type": [
                "integer",
                "null"
              ]
            },
            "snapshot": {
              "type": "object",
              "properties": {
                "profileVersion": {
                  "type": "integer",
                  "minimum": 1
                },
                "owner": {
                  "type": "object",
                  "properties": {
                    "displayName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 30
                    },
                    "avatar": {
                      "enum": [
                        "dragon",
                        "bear",
                        "mocha"
                      ]
                    }
                  },
                  "required": [
                    "displayName",
                    "avatar"
                  ],
                  "additionalProperties": false
                },
                "trip": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                    },
                    "plan": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "destination": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "startDate": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                        },
                        "endDate": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                        },
                        "summary": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 800
                        },
                        "days": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 14,
                          "items": {
                            "type": "object",
                            "properties": {
                              "dayNumber": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 14
                              },
                              "date": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                              },
                              "stops": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 12,
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "time": {
                                      "type": [
                                        "string",
                                        "null"
                                      ],
                                      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                                    },
                                    "title": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 100
                                    },
                                    "description": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 500
                                    },
                                    "category": {
                                      "type": "string",
                                      "enum": [
                                        "walk",
                                        "cafe",
                                        "food",
                                        "culture",
                                        "nature",
                                        "rest",
                                        "drive"
                                      ]
                                    },
                                    "placeQuery": {
                                      "type": [
                                        "string",
                                        "null"
                                      ],
                                      "maxLength": 150
                                    }
                                  },
                                  "required": [
                                    "time",
                                    "title",
                                    "description",
                                    "category",
                                    "placeQuery"
                                  ],
                                  "additionalProperties": false
                                }
                              }
                            },
                            "required": [
                              "dayNumber",
                              "date",
                              "stops"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "notes": {
                          "type": "array",
                          "maxItems": 12,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          }
                        }
                      },
                      "required": [
                        "title",
                        "destination",
                        "startDate",
                        "endDate",
                        "summary",
                        "days",
                        "notes"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "plan"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "profileVersion",
                "owner",
                "trip"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "pairingId",
            "revision",
            "createdAt",
            "acknowledgedAt",
            "snapshot"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "scope",
    "status",
    "device",
    "canInteract",
    "pairing",
    "delivery"
  ],
  "additionalProperties": false
}
