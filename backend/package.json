{
  "name": "waymate-agent-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "start": "node --env-file-if-exists=demo/.env --env-file-if-exists=.env server/main.mjs",
    "start:scenario": "node --env-file-if-exists=demo/.env --env-file-if-exists=.env server/scenario-main.mjs",
    "test:scenario": "node --test tests/scenario-flow.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "openai": "7.57.0"
  }
}
