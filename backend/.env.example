OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SERVICE_PORT=3004
SERVICE_HOST=127.0.0.1
SERVICE_PUBLIC_ORIGIN=http://127.0.0.1:3004
SERVICE_DB_PATH=runtime/waymate.sqlite
# Local filming only: enables the v4 Pleos gateway and a separate Solbaram response screen.
# Build the vehicle with waymateApiPort matching SERVICE_PORT. Keep disabled in production.
SERVICE_SCENARIO_DEMO=0

# Optional TTS. Server-only; leave API key empty to disable.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional character overrides; fall back to ELEVENLABS_VOICE_ID.
ELEVENLABS_VOICE_DRAGON=
ELEVENLABS_VOICE_BEAR=
ELEVENLABS_VOICE_MOCHA=
