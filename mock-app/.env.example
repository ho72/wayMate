# Copy to .env locally. Never commit real credentials.
WAYMATE_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Vehicle dialogue reuses OPENAI_API_KEY. One packet per stable trip/profile;
# failed calls count too. Persistent cache survives server restarts.
WAYMATE_DIALOGUE_PROVIDER=openai
OPENAI_DIALOGUE_MODEL=gpt-4.1-mini
WAYMATE_DIALOGUE_MAX_CALLS=3
# Separate from the existing Pleos rehearsal server/state while validating AI.
WAYMATE_PORT=3000
WAYMATE_STATE_FILE=runtime/ai-consultation-v4.json

# Optional TTS. Independent of WAYMATE_AI_PROVIDER; server-only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_DRAGON=
ELEVENLABS_VOICE_BEAR=
